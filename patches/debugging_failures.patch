+
+    // Fallback: Check for plain text format (e.g. "INCORRECT\n\nExplanation...")
+    const trimmed = response.trim()
+    const firstLine = trimmed.split("\n")[0].toLowerCase()
+
+    if (firstLine.includes("incorrect")) {
+      return {
+        score: 0,
+        label: "incorrect",
+        explanation: trimmed.substring(firstLine.length).trim(),
+      }
     }
+
+    if (firstLine.includes("correct")) {
+      return {
+        score: 1,
+        label: "correct",
